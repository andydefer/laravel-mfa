{
    "name": "andydefer/laravel-mfa",
    "description": "Laravel MFA: A flexible, multi-purpose Multi-Factor Authentication management system for Laravel applications with support for OTP (email/sms), TOTP (Google Authenticator), passwordless login, 2FA, and action confirmation.",
    "type": "library",
    "license": "MIT",
    "keywords": [
        "laravel",
        "mfa",
        "2fa",
        "totp",
        "otp",
        "google-authenticator",
        "two-factor-authentication",
        "multi-factor-authentication",
        "passwordless",
        "security"
    ],
    "homepage": "https://github.com/andydefer/laravel-mfa",
    "authors": [
        {
            "name": "Andy Defer",
            "email": "andy@defer.com",
            "role": "Developer"
        }
    ],
    "autoload": {
        "psr-4": {
            "AndyDefer\\Mfa\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "AndyDefer\\Mfa\\Tests\\": "tests/"
        }
    },
    "config": {
        "allow-plugins": {
            "pestphp/pest-plugin": true
        },
        "sort-packages": true,
        "optimize-autoloader": true
    },
    "extra": {
        "laravel": {
            "providers": [
                "AndyDefer\\Mfa\\MfaServiceProvider"
            ],
            "aliases": {
                "Mfa": "AndyDefer\\Mfa\\Facades\\Mfa"
            }
        }
    },
    "require": {
        "php": ">=8.1",
        "andydefer/laravel-directive": "^3.59.6",
        "andydefer/laravel-repository": "^2.14.11",
        "laravel/framework": "^12.0",
        "paragonie/constant_time_encoding": "^3.1",
        "spomky-labs/otphp": "^11.4"
    },
    "require-dev": {
        "barryvdh/laravel-ide-helper": "^3.6",
        "larastan/larastan": "^3.8",
        "laravel/pint": "^1.26",
        "orchestra/testbench": "^10.8",
        "phpunit/phpunit": "^12.5",
        "rector/rector": "*",
        "symfony/var-dumper": "^7.0",
        "vimeo/psalm": "^6.14"
    },
    "suggest": {
        "ext-imagick": "Required to generate QR codes as images",
        "ext-gd": "Alternative to Imagick for QR code generation"
    },
    "scripts": {
        "test": "phpunit",
        "test-coverage": "phpunit --coverage-html coverage",
        "analyse": "vendor/bin/phpstan analyse",
        "lint": "vendor/bin/pint",
        "psalm": "vendor/bin/psalm"
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
