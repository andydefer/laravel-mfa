{
    "name": "andydefer/laravel-otp",
    "description": "Laravel OTP: A flexible, multi-purpose One-Time Password management system for Laravel applications with support for email verification, phone verification, passwordless login, 2FA, and action confirmation.",
    "type": "library",
    "license": "MIT",
    "autoload": {
        "psr-4": {
            "Kani\\Otp\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Kani\\Otp\\Tests\\": "tests/"
        }
    },
    "config": {
        "allow-plugins": {
            "pestphp/pest-plugin": true
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Kani\\Otp\\OtpServiceProvider"
            ]
        }
    },
    "require": {
        "php": ">=8.1",
        "laravel/framework": "^12.0"
    },
    "require-dev": {
        "barryvdh/laravel-ide-helper": "^3.6",
        "larastan/larastan": "^3.8",
        "laravel/pint": "^1.26",
        "orchestra/testbench": "^10.8",
        "phpunit/phpunit": "^12.5",
        "rector/rector": "*",
        "symfony/var-dumper": "^7.0",
        "vimeo/psalm": "^6.14"
    }
}